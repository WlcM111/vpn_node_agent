# Шаблон окружения vpn-node-agent (скопировать в .env в корне репозитория на ноде/relay)
NODE_ID=cas-main-1
SERVER_KEY=cas-main-1
KAFKA_BROKERS=race-src.com:19092

XRAY_APPLY_MODE=api
XRAY_API_ADDR=127.0.0.1:10085

NODE_AGENT_STATE_PATH=/var/lib/vpn-node-agent/state.json
NODE_AGENT_PENDING_PATH=/var/lib/vpn-node-agent/pending_events.json
NODE_AGENT_HEARTBEAT_INTERVAL=30s
NODE_AGENT_TRAFFIC_INTERVAL=60s
NODE_AGENT_APPLY_TIMEOUT=10s
NODE_AGENT_HTTP_ADDR=127.0.0.1:9091
NODE_AGENT_INBOUND_TAGS=
LOG_LEVEL=info

# mTLS для подключения к центральной Kafka (порт 19092)
KAFKA_TLS_ENABLED=true
KAFKA_TLS_HOST_DIR=/etc/vpn-node-agent/kafka-tls
KAFKA_TLS_CA_CERT=/etc/vpn-node-agent/kafka-tls/ca.crt
KAFKA_TLS_CLIENT_CERT=/etc/vpn-node-agent/kafka-tls/client.crt
KAFKA_TLS_CLIENT_KEY=/etc/vpn-node-agent/kafka-tls/client.key
KAFKA_TLS_SERVER_NAME=race-src.com
